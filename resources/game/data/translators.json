  { "id": "assertModule", "name": "断言模块", "tier": "high", "boss": "verifier", "stackable": false, "desc": "攻击骰子伤害+30%。", "onBattle": [{ "fx": "dealMult", "params": { "value": 1.3, "label": "断言模块", "when": { "dieKinds": "ATTACK" } } }] },
