  { "id": "branchPredictor", "name": "分支预测", "tier": "core", "stackable": false, "desc": "常规：每场战斗开始获得1次≤3点重抽充能。核心：手动重抽后新骰≥5点时，本次行动效果+30%。", "onBattle": [{ "fx": "on", "params": { "event": "battleStart", "do": [{ "fx": "rerollCharges", "params": { "count": 1, "text": "分支预测：重抽充能+1" } }] } }, { "fx": "actionMult", "ifSlotted": true, "params": { "mult": 1.3, "label": "分支预测·核心", "when": { "rerollHighPips": true } } }] },
  { "id": "memoryAlign", "name": "内存对齐", "tier": "core", "stackable": false, "desc": "常规：获得时最大生命+10%（本局永久）。核心：治疗效果+25%，每场开始获得1层护盾。", "onAcquire": [{ "fx": "modMaxHp", "params": { "mult": 1.1 } }], "onBattle": [{ "fx": "healMult", "ifSlotted": true, "params": { "value": 1.25, "label": "内存对齐·核心" } }, { "fx": "on", "ifSlotted": true, "params": { "event": "battleStart", "do": [{ "fx": "shield", "params": { "layers": 1, "label": "内存对齐·核心" } }] } }] },
