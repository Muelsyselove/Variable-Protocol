  { "id": "aegisDock", "name": "神盾坞", "tier": "normal", "stackable": false, "price": 150, "desc": "每回合开始时，若持有护盾层，获得300点屏障。◇连携【协变核心】：开战额外获得1层护盾。", "onBattle": [{ "fx": "on", "params": { "event": "turnStart", "when": { "selfAlive": true, "hasShield": true }, "do": [{ "fx": "barrier", "params": { "amount": 300, "label": "神盾坞" } }] } }], "synergy": { "requires": ["covarianceCore"], "desc": "与协变核心同持：开战额外获得1层护盾", "onBattle": [{ "fx": "on", "params": { "event": "battleStart", "do": [{ "fx": "shield", "params": { "layers": 1, "label": "神盾坞·连携" } }] } }] } },
  { "id": "fortressProtocol", "name": "要塞协议", "tier": "normal", "stackable": false, "price": 150, "desc": "每回合开始时，若没有护盾层，获得1层护盾。◇连携【屏障再生】：其再生量300→600；【伤害封顶】：其上限20%→15%。", "onBattle": [{ "fx": "on", "params": { "event": "turnStart", "when": { "selfAlive": true, "hasShield": false }, "do": [{ "fx": "shield", "params": { "layers": 1, "label": "要塞协议" } }] } }], "synergy": { "requires": ["barrierRegen"], "desc": "与屏障再生/伤害封顶同持时强化其数值（修正型联动，自动生效）" } },
  { "id": "survivalInstinct", "name": "求生本能", "tier": "normal", "stackable": false, "price": 120, "desc": "生命低于50%时，造成的伤害+20%。◇连携【玻璃大炮】：取消其受伤+10%负面，且低血伤害额外+15%。", "onBattle": [{ "fx": "dealMult", "params": { "value": 1.2, "label": "求生本能", "when": { "selfHpBelow": 0.5 } } }], "synergy": { "requires": ["glassCannon"], "desc": "与玻璃大炮同持：低血伤害额外+15%（负面取消在玻璃大炮侧生效）", "onBattle": [{ "fx": "dealMult", "params": { "value": 1.15, "label": "求生本能·连携", "when": { "selfHpBelow": 0.5 } } }] } },
  { "id": "lastStand", "name": "背水一战", "tier": "normal", "stackable": false, "price": 150, "desc": "生命低于25%时，获得20%闪避。◇连携【应急熔断】：其复活生命30%→60%，并附带2层护盾。", "onBattle": [{ "fx": "judge", "params": { "kind": "dodge", "chance": 0.2, "hpBelow": 0.25, "label": "背水一战", "proc": "背水一战：闪避" } }], "synergy": { "requires": ["fuseBreaker"], "desc": "与应急熔断同持：复活强化（修正型联动，在应急熔断侧生效）" } },
  { "id": "bloodArmor", "name": "凝血装甲", "tier": "normal", "stackable": false, "price": 120, "desc": "生命低于50%时，每回合开始获得攻击力×60%的屏障。◇连携【自动补丁】：战后恢复额外+10%；【生命模组】：低血阈值放宽至60%。", "onBattle": [{ "fx": "on", "params": { "event": "turnStart", "when": { "selfAlive": true, "selfHpBelow": { "value": 0.5, "with": { "hpModule": 0.6 } } }, "do": [{ "fx": "barrier", "params": { "atkMult": 0.6, "label": "凝血装甲" } }] } }], "onVictory": [{ "fx": "healPct", "params": { "value": 0.10, "ifHas": "autoPatch" } }], "synergy": { "requires": ["autoPatch"], "desc": "与自动补丁同持：战后恢复额外+10%（生命模组阈值联动为修正型）" } },
  { "id": "psyCatalyst", "name": "心智催化", "tier": "normal", "stackable": false, "price": 120, "desc": "敌方触发心理崩溃时，我方回复15%最大生命。◇连携【异常捕获】：其附加心理伤害10000→15000。", "onBattle": [{ "fx": "on", "params": { "event": "crash", "on": "foe", "when": { "eventUnitAlive": true }, "do": [{ "fx": "heal", "params": { "hpPct": 0.15 } }, { "fx": "proc", "params": { "label": "心智催化：回复15%生命" } }] } }], "synergy": { "requires": ["exceptionCatch"], "desc": "与异常捕获同持：强化其附加伤害（修正型联动，在异常捕获侧生效）" } },
  { "id": "nightmareEcho", "name": "噩梦回响", "tier": "normal", "stackable": false, "price": 150, "desc": "崩溃中的敌人每回合开始时，受到1000点心理伤害（生命伤害）。◇连携【崩溃利用】：对崩溃敌人增伤30%→50%。", "onBattle": [{ "fx": "on", "params": { "event": "turnStart", "when": { "foeCrash": true }, "do": [{ "fx": "damage", "params": { "dtype": "PSYCHIC", "amount": 1000, "cause": "nightmareEcho", "target": "foe" } }] } }], "synergy": { "requires": ["crashExploit"], "desc": "与崩溃利用同持：增伤强化（修正型联动，在崩溃利用侧生效）" } },
  { "id": "synapseBurn", "name": "突触灼蚀", "tier": "normal", "stackable": false, "price": 120, "desc": "敌方心理崩溃结束时，立即受到3000点心理伤害。◇连携【心理透镜】：其每层心理损伤加成15%→22%。", "onBattle": [{ "fx": "on", "params": { "event": "crashEnd", "on": "foe", "when": { "eventUnitAlive": true }, "do": [{ "fx": "damage", "params": { "dtype": "PSYCHIC", "amount": 3000, "cause": "synapseBurn", "target": "eventUnit" } }] } }], "synergy": { "requires": ["psyLens"], "desc": "与心理透镜同持：加成强化（修正型联动，在心理透镜侧生效）" } },
  { "id": "poolArchitect", "name": "骰池架构", "tier": "normal", "stackable": false, "price": 150, "desc": "骰池每超出10颗1颗，攻击力+3%（实时）。◇连携【栈溢出】：其计数阈值第7颗→第5颗；【虚拟内存】：骰池上限再+2。", "onBattle": [{ "fx": "dyn", "params": { "kind": "atkPoolOver", "base": 10, "per": 0.03, "label": "骰池架构" } }], "synergy": { "requires": ["stackOverflow"], "desc": "与栈溢出同持：阈值强化；与虚拟内存同持：上限再+2（修正型联动）" } },
  { "id": "diceCurator", "name": "骰子策展", "tier": "normal", "stackable": false, "price": 120, "desc": "骰池中每存在1种不同的骰子类型（去重），攻击力+3%。◇连携【镜像池】：其镜像复制变为2颗。", "onBattle": [{ "fx": "dyn", "params": { "kind": "atkDistinctKinds", "per": 0.03, "label": "骰子策展" } }], "synergy": { "requires": ["mirrorPool"], "desc": "与镜像池同持：复制数量强化（修正型联动，在镜像池侧生效）" } },
  { "id": "consecBeacon", "name": "连击信标", "tier": "normal", "stackable": false, "price": 120, "desc": "连续抽出第3颗及以上同类型骰子时，回复攻击力×30%的生命。◇连携【连击引擎】：其第2颗增伤30%→45%；【尾递归优化】：其第3颗倍率×2→×2.5。", "onBattle": [{ "fx": "on", "params": { "event": "actionResolved", "on": "self", "when": { "consecGte": 3 }, "do": [{ "fx": "heal", "params": { "atkPct": 0.3 } }, { "fx": "proc", "params": { "label": "连击信标：回复" } }] } }], "synergy": { "requires": ["comboEngine"], "desc": "与连击引擎/尾递归优化同持：数值强化（修正型联动，在对侧生效）" } },
  { "id": "fragileForge", "name": "易碎熔炉", "tier": "normal", "stackable": false, "price": 120, "desc": "所有易碎骰子的效果+25%。◇连携【骰子淬火】：被淬火保留的易碎骰效果+25%→+45%。", "onBattle": [{ "fx": "actionMult", "params": { "mult": 1.25, "with": { "dieHardening": { "mult": 1.45 } }, "label": "易碎熔炉", "when": { "dieKinds": "FRAGILE_SELF" } } }], "synergy": { "requires": ["dieHardening"], "desc": "与骰子淬火同持：易碎骰增伤25%→45%（本体内已读取持有状态）" } },
  { "id": "fluxLens", "name": "通量透镜", "tier": "normal", "stackable": false, "price": 150, "desc": "开战时，每持有200通量攻击力+3%（上限15%，按开战时快照）。◇连携【复利计息】：其单次上限50→100。", "onBattle": [{ "fx": "on", "params": { "event": "battleStart", "do": [{ "fx": "fluxSnapshot", "params": { "perFlux": 200, "step": 0.03, "cap": 0.15, "label": "通量透镜" } }] } }], "synergy": { "requires": ["compoundInterest"], "desc": "与复利计息同持：上限强化（修正型联动，在复利计息侧生效）" } },
  { "id": "angelInvestor", "name": "天使投资", "tier": "normal", "stackable": false, "price": 90, "desc": "每次在商店购买转译器后，下一场战斗攻击力+15%。◇连携【贪婪采样】：其商店折扣20%→30%。", "synergy": { "requires": ["greedySample"], "desc": "与贪婪采样同持：商店折扣20%→30%（在商店侧生效）" } },
  { "id": "luckyStreak", "name": "连胜势头", "tier": "normal", "stackable": false, "price": 120, "desc": "抢先手行动时，本次行动效果+15%。◇连携【平局仲裁】：平局取胜的当回合效果+30%。", "onBattle": [{ "fx": "actionMult", "params": { "mult": 1.15, "label": "连胜势头", "when": { "orderFirst": true, "tieMult": 1.3 } } }], "synergy": { "requires": ["tieBreaker"], "desc": "与平局仲裁同持：平局取胜回合效果+30%（本体内已读取战斗状态）" } },
  { "id": "rerollMastery", "name": "重抽大师", "tier": "normal", "stackable": false, "price": 120, "desc": "重抽后的新骰子，本次行动效果+25%。◇连携【量子重掷】：其每场次1→2；【频率偏移】：开战额外+1充能。", "onBattle": [{ "fx": "actionMult", "params": { "mult": 1.25, "label": "重抽大师", "when": { "rerolled": true } } }], "synergy": { "requires": ["quantumReroll"], "desc": "与量子重掷/频率偏移同持：充能强化（修正型联动，在对侧生效）" } },
  { "id": "decayProtocol", "name": "衰变协议", "tier": "normal", "stackable": false, "price": 120, "desc": "攻击附加\"衰变\"：敌方2回合内每回合开始受到500点真实伤害（每次行动至多附加一层）。◇连携【内存泄漏】：其灼烧比例1%→1.5%；【轮询扫描】：其扫描真伤+100/层。", "onBattle": [{ "fx": "flag", "params": { "name": "decayOnHit", "value": 500 } }], "synergy": { "requires": ["memLeak"], "desc": "与内存泄漏/轮询扫描同持：数值强化（修正型联动，在对侧生效）" } },
  { "id": "entropyEngine", "name": "熵减引擎", "tier": "core", "stackable": false, "desc": "常规：战斗开始时加入1颗5点攻击骰子。核心：骰池中每有1颗点数≥5的骰子，攻击力+2%。", "onBattle": [{ "fx": "on", "params": { "event": "battleStart", "do": [{ "fx": "addDie", "params": { "spec": { "id": "attack", "pips": 5, "kinds": ["ATTACK"], "onRoll": [{ "fx": "attack" }] }, "silent": true } }, { "fx": "info", "params": { "text": "熵减引擎：加入1颗5点攻击骰子" } }] } }, { "fx": "dyn", "ifSlotted": true, "params": { "kind": "atkPipsGteCount", "pips": 5, "per": 0.02, "label": "熵减引擎" } }] },
