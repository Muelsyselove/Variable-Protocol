  { "id": "memLeak", "name": "内存泄漏", "tier": "high", "boss": "recursion", "stackable": false, "desc": "敌方每回合开始时，受到相当于其最大生命值1%的真实伤害。◇连携【衰变协议】：灼烧比例1%→1.5%。", "onBattle": [{ "fx": "on", "params": { "event": "turnStart", "when": { "foeAlive": true }, "do": [{ "fx": "damage", "params": { "dtype": "TRUE", "foeMaxHpPct": 0.01, "with": { "decayProtocol": { "foeMaxHpPct": 0.015 } }, "cause": "memLeak", "target": "foe" } }] } }] },
  { "id": "stackOverflow", "name": "栈溢出", "tier": "high", "boss": "recursion", "stackable": false, "desc": "我方骰池中第7颗及以后的每颗骰子，使攻击力+8%。◇连携【骰池架构】：计数阈值第7颗→第5颗。", "onBattle": [{ "fx": "dyn", "params": { "kind": "atkPoolOverThreshold", "threshold": 6, "with": { "poolArchitect": { "threshold": 4 } }, "per": 0.08, "label": "栈溢出" } }] },
