  { "id": "deadCode", "name": "死代码清除", "tier": "core", "stackable": false, "desc": "常规：每场开始摧毁敌方1颗随机骰子。核心：每回合开始20%概率摧毁敌方1颗随机骰子。", "onBattle": [{ "fx": "on", "params": { "event": "battleStart", "do": [{ "fx": "removeFoeDice", "params": { "which": "random", "count": 1, "text": "死代码清除：摧毁敌方1颗骰子" } }] } }, { "fx": "on", "ifSlotted": true, "params": { "event": "turnStart", "when": { "selfAlive": true, "foeAlive": true }, "do": [{ "fx": "removeFoeDice", "params": { "which": "random", "count": 1, "chance": 0.2, "text": "死代码清除·核心：摧毁敌方1颗骰子" } }] } }] },
